<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.todoapp.todo.dao.mapper.TodoMapper">

    <resultMap id="TodoResultMap" type="com.todoapp.todo.dao.entity.TodoDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="creator" property="creator" jdbcType="VARCHAR"/>
        <result column="tenant_id" property="tenantId" jdbcType="VARCHAR"/>
        <result column="gmt_create" property="gmtCreate" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.todoapp.todo.dao.entity.TodoDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo (title, description, creator, tenant_id, gmt_create, gmt_modified)
        VALUES (#{title}, #{description}, #{creator}, #{tenantId}, NOW(), NOW())
    </insert>

</mapper>
