<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dtaz.todo.dao.mapper.TodoItemMapper">

    <resultMap id="TodoItemResultMap" type="com.dtaz.todo.model.do.TodoItemDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="title" property="title" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="gmt_create" property="gmtCreate" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.dtaz.todo.model.do.TodoItemDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo_item (title, description)
        VALUES (#{title}, #{description})
    </insert>

</mapper>