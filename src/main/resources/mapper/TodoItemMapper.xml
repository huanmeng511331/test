<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.antdigital.todo.dao.mapper.TodoItemMapper">

    <!-- 按需新增，使用数据库默认值填充 gmt_create/gmt_modified -->
    <insert id="insert" parameterType="com.antdigital.todo.model.do.TodoItemDO"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO todo_item (item_name, description)
        VALUES (#{itemName}, #{description})
    </insert>

</mapper>