<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dtaz.todo.dao.mapper.TodoMapper">

    <resultMap id="TodoResultMap" type="com.dtaz.todo.model.entity.TodoDO">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="name" property="name" jdbcType="VARCHAR"/>
        <result column="description" property="description" jdbcType="VARCHAR"/>
        <result column="gmt_create" property="gmtCreate" jdbcType="TIMESTAMP"/>
        <result column="gmt_modified" property="gmtModified" jdbcType="TIMESTAMP"/>
    </resultMap>

    <insert id="insert" parameterType="com.dtaz.todo.model.entity.TodoDO"
            useGeneratedKeys="true" keyProperty="todo.id">
        INSERT INTO todo (name, description, gmt_create, gmt_modified)
        VALUES (#{todo.name}, #{todo.description}, #{todo.gmtCreate}, #{todo.gmtModified})
    </insert>

    <select id="findById" resultMap="TodoResultMap">
        SELECT id, name, description, gmt_create, gmt_modified
        FROM todo
        WHERE id = #{id}
    </select>

</mapper>